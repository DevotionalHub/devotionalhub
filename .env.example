# Browser-safe Supabase settings. Copy to .env.local and fill from the
# Supabase Dashboard Connect dialog.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public base URL of the deployed site, with no trailing slash, e.g.
# https://devotionalhub.netlify.app
# Used to build the links inside confirmation and password-reset emails so they
# always point at the live site. Leave blank for local development (the browser
# origin is used instead). ALWAYS set this in Netlify to your production domain.
NEXT_PUBLIC_SITE_URL=

# Server-only secret. Never expose this value in browser code or commit it.
SUPABASE_SECRET_KEY=
